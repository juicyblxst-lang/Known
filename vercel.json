{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://known-sbbp.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/frontend/landing.html"
    },
    {
      "source": "/:path*",
      "destination": "/frontend/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    }
  ]
}
