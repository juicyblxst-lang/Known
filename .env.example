# AI
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5-mini

# Supabase structured application data + Auth validation
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
KNOWN_BUSINESS_ID=

# Public Known URL
KNOWN_PUBLIC_URL=http://localhost:8000

# Gmail / Google OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/integrations/gmail/callback
GMAIL_STATE_SECRET=
KNOWN_GMAIL_CRON_SECRET=

# Sibyl Memory (official sibyl-memory-client)
# IMPORTANT: this path must be on persistent storage in production.
SIBYL_MEMORY_DB=/data/sibyl/memory.db
SIBYL_ACCOUNT_ID=
SIBYL_SESSION_TOKEN=
SIBYL_TIER=free

# Shopify public app / API integration (future scope; intentionally not used by onboarding)
SHOPIFY_CLIENT_ID=
SHOPIFY_CLIENT_SECRET=
SHOPIFY_REDIRECT_URI=https://YOUR_PUBLIC_HOST/api/shopify/callback
SHOPIFY_WEBHOOK_URL=https://YOUR_PUBLIC_HOST/api/shopify/webhooks
SHOPIFY_SCOPES=read_customers,read_orders
SHOPIFY_API_VERSION=2026-07
SHOPIFY_TOKEN_ENCRYPTION_KEY=

# Backend CORS
KNOWN_CORS_ORIGINS=http://localhost:3000,http://localhost:8000
